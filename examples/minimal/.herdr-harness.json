{
  "$schema": "../../herdr-harness.schema.json",
  "name": "example-repo",
  "enabled": true,
  "agent": "grok-build",
  "soul": "templates/soul.md",
  "adapters": {
    "default": "grok-build",
    "routes": {
      "grok-build": { "kind": "grok", "model": "grok-build" },
      "claude": { "kind": "claude" },
      "anyr": { "kind": "anyr", "via": "claude" },
      "codex": { "kind": "codex", "flags": ["--yolo"] },
      "opencode": { "kind": "opencode", "flags": ["--agent", "build"] }
    }
  },
  "tasks": [
    {
      "id": "mvp-review",
      "adapter": "grok-build",
      "worktree": { "branch": "harness/mvp-review" }
    },
    { "id": "docs", "adapter": "claude" },
    { "id": "anyr-via", "adapter": "anyr" },
    { "id": "codex-task", "adapter": "codex" }
  ],
  "playbooks": [
    {
      "id": "desk:sentry-issues",
      "description": "Sentry/Bugsink error events → mock GitHub issue drafts (on-demand ingest, no GitHub API, no cron)"
    }
  ]
}
